---
import { Snowflake } from "lucide-astro";
const links = [["Twitter/X", "#"], ["GitHub", "#"], ["Discord", "#"], ["Privacy Policy", "#"]];
---
<footer class="border-t border-zinc-800">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-4 py-8 font-mono text-xs text-zinc-500 md:flex-row">
    <div class="flex flex-wrap items-center justify-center gap-3">
      <span class="grid size-6 place-items-center rounded-sm bg-white text-black"><Snowflake size={14} /></span>
      <span class="font-bold text-white">Coldmetal</span>
      <span>© 2026 Coldmetal. All rights reserved.</span>
    </div>
    <nav class="flex flex-wrap justify-center gap-6">
      {links.map(([label, href]) => <a href={href} class="transition hover:text-white">{label}</a>)}
    </nav>
  </div>
</footer>
