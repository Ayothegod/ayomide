import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
const { title = "Coldmetal — The missing QA layer for AI coding agents" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Coldmetal verifies AI-generated examples, configs, and SDK snippets work before you ship." />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
